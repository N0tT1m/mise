# Copy to .env and fill in. Never commit the filled version.
#
# docker compose reads this file automatically. The pipeline does NOT --
# export it into your shell first:  set -a; . ./.env; set +a

# Postgres container credentials. compose refuses to start if these are unset.
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DATABASE=mise
POSTGRES_USERNAME=mise

# How the pipeline reaches that container. Must agree with the three above and
# with the published port in docker-compose.yml. Percent-encode any special
# characters in the password -- `!` becomes %21.
MISE_DATABASE_URL=postgres://mise:CHANGEME@localhost:16432/mise?sslmode=disable

# Inference endpoint for extract (phase 1) and generate (phase 5).
# OpenAI-compatible; only this value changes when swapping to a hosted API.
MISE_INFERENCE_URL=http://localhost:8000
