# Copy to .env and fill in. Never commit the filled version.
# The app refuses to start if MISE_DATABASE_URL is unset - that is deliberate.

MISE_DATABASE_URL=postgres://mise@localhost:5432/mise?sslmode=disable

# Listen address. Defaults to :8000 when unset.
MISE_ADDR=:8000

# Local inference during phase A. Swap for a hosted API in phase B; the
# interface is the same and only this value changes.
MISE_INFERENCE_URL=http://localhost:8080
