# Copy to .env and fill in. Never commit the filled version.
# The app refuses to start if MISE_DATABASE_URL is unset - that is deliberate.
#
# Compose credentials (POSTGRES_*) live in the repo-root .env, not here --
# the API never reads them. Keep this DSN in agreement with that file and
# with the published port in docker-compose.yml.

MISE_DATABASE_URL=postgres://mise:CHANGEME@localhost:16432/mise?sslmode=disable

# Listen address. Defaults to :8000 when unset.
MISE_ADDR=:8000

# Local inference during phase A. Swap for a hosted API in phase B; the
# interface is the same and only this value changes. vLLM serves an
# OpenAI-compatible API at <this>/v1/chat/completions.
MISE_INFERENCE_URL=http://localhost:8000
